# Copy to .env (never commit .env) and fill in to enable the morning email.
# docker compose picks these up automatically.

# --- SMTP ---
# Outlook/Hotmail: smtp-mail.outlook.com (enable 2FA, then create an app password)
# Gmail:           smtp.gmail.com       (enable 2FA, then create an app password)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=you@outlook.com
SMTP_PASS=your-app-password
DIGEST_TO=you@outlook.com

# --- Schedule ---
DIGEST_TIME=07:30
DIGEST_TZ=America/New_York
# "weekdays" (default) or "daily"
DIGEST_DAYS=weekdays
